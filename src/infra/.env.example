# src/infra/.env.example — infra-only environment variables.
#
# This file documents ONLY the variables docker-compose.yml / docker-compose.override.yml
# in THIS directory read directly. For the full set of application-level variables
# (per-service DB connection strings, JWT secret, Google/Firebase config, etc.) see the
# repo-root .env.example — that one file is the single source of truth for the whole
# stack so service teams don't have to hunt across multiple .env files to find a value.
#
# Copy this to `.env` in this same folder ONLY if you intend to run
# `docker compose up` from inside src/infra directly. If you run it from the repo
# root (as the /docker-up command does), copy the ROOT .env.example to a ROOT .env
# instead — it also sets COMPOSE_FILE so root-level `docker compose up -d` finds
# these compose files automatically.
#
# NEVER commit a real .env — it is in .gitignore.

# SQL Server SA password. Must satisfy SQL Server's complexity policy: at least 8
# chars, with uppercase, lowercase, a digit, and a symbol. Used by both the
# `sqlserver` service and the `sqlserver-init` one-shot database-creation job.
SA_PASSWORD=<strong-password-here>
