<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>chat_service</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- T036: SignalR's default backplane only fans a broadcast out to
         connections held by THIS process. Chat Service will eventually run
         as more than one replica (same reasoning as every other service in
         this project), so a message sent to a SignalR group must reach
         every replica's connections, not just the one that happened to
         receive the SendMessage call - this package is what lets every
         instance subscribe to the same Redis Pub/Sub channel and relay each
         other's broadcasts. Installed via `dotnet add package` (not a
         scaffolding/codegen command per CLAUDE.md's CLI rule), so it was run
         directly rather than handed to the Tech Lead. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="9.0.9" />

    <!-- Official MongoDB .NET driver. 3.x line is the current stable major
         compatible with .NET 9 (2.x is EOL/targets older TFMs). This is the
         only package chat-service needs for Mongo access - no ORM layer on
         top, since the Repository classes below talk to IMongoCollection<T>
         directly. -->
    <PackageReference Include="MongoDB.Driver" Version="3.1.0" />

    <!-- T038: chat-service's first Kafka consumer (ConnectionAcceptedConsumer).
         Same package + version user-service's KafkaUserVerifiedEventPublisher
         already references for its producer - one Kafka client library
         version across every .NET service in this project, so the wire
         protocol/behavior quirks a developer learns on one service's
         producer carry over directly to another service's consumer. Added by
         hand-editing this file (per CLAUDE.md's CLI-command rule) rather than
         running `dotnet add package`, since that command itself is a plain
         file write here, not a scaffolding/codegen step. -->
    <PackageReference Include="Confluent.Kafka" Version="2.15.0" />
  </ItemGroup>

</Project>
