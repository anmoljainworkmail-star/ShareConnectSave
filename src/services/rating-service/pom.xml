<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.5</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.shareconnectsave</groupId>
	<artifactId>rating-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>rating-service</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Same "pin third-party versions as a property" convention as
		     discovery-service's pom.xml (T021) — mssql-jdbc/flyway-core/
		     flyway-sqlserver are deliberately NOT listed here because
		     spring-boot-starter-parent's BOM already pins those. -->
		<mapstruct.version>1.6.3</mapstruct.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Kafka: no producer/consumer code exists in THIS ticket
		     (T041 is setup + schema only), but it is declared now because
		     later Phase 7 tickets in this same service (rating.submitted
		     producer, trust.score.updated producer, chat.closed consumer)
		     need it, and the ticket's own "What to build" list calls it out
		     explicitly. spring-kafka-test is intentionally OMITTED (unlike
		     discovery-service's pom.xml) — it has no test code to support
		     yet, and adding a test dependency for code that doesn't exist
		     would be speculative work this project's convention avoids.
		     Add it back in the ticket that actually writes a Kafka
		     consumer/producer test. -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<!-- Flyway: version-controlled, one-way-forward schema migrations
		     instead of Hibernate's ddl-auto=update. flyway-sqlserver is a
		     separate artifact from flyway-core (see discovery-service's
		     pom.xml comment on this same pair) — without it Flyway throws
		     "Unsupported Database: Microsoft SQL Server" at startup even
		     though the JDBC driver itself connects fine. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-sqlserver</artifactId>
		</dependency>

		<!-- JDBC driver for spring.datasource.url's jdbc:sqlserver: scheme.
		     scope=runtime because application code talks to Hibernate/JPA,
		     never this driver class, directly. -->
		<dependency>
			<groupId>com.microsoft.sqlserver</groupId>
			<artifactId>mssql-jdbc</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- DRY via shared library, not inheritance: pulls in ErrorResponse +
		     GlobalExceptionHandler (T003) so this service's HTTP error
		     envelope is byte-for-byte identical to every other Java
		     service's. -->
		<dependency>
			<groupId>com.shareconnectsave</groupId>
			<artifactId>shared-java-lib</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>

		<!-- MapStruct: compile-time-generated DTO mapping. No DTOs exist yet
		     in this setup-only ticket, but declared now (per the ticket's
		     explicit dependency list) so the annotation-processor wiring
		     below is already correct for the first feature ticket that adds
		     one. -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<!-- Pattern: annotation processor ORDER matters — Lombok must
				     run before MapStruct (see discovery-service's pom.xml
				     comment on this exact point). lombok-mapstruct-binding
				     is the shim that pins that ordering across javac/IDE
				     combinations. -->
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok-mapstruct-binding</artifactId>
									<version>0.2.0</version>
								</path>
								<path>
									<groupId>org.mapstruct</groupId>
									<artifactId>mapstruct-processor</artifactId>
									<version>${mapstruct.version}</version>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok-mapstruct-binding</artifactId>
									<version>0.2.0</version>
								</path>
								<path>
									<groupId>org.mapstruct</groupId>
									<artifactId>mapstruct-processor</artifactId>
									<version>${mapstruct.version}</version>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
