<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.5</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.shareconnectsave</groupId>
	<artifactId>report-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>report-service</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Same "pin third-party versions as a property" convention as
		     discovery-service's/rating-service's pom.xml. -->
		<mapstruct.version>1.6.3</mapstruct.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- shared-java-lib: the shared ErrorResponse + GlobalExceptionHandler
		     error-envelope contract every other Java service already depends
		     on. T051 omitted this (it shipped no controller, so the gap was
		     never exercised) — T052's POST /reports is report-service's FIRST
		     controller, so this dependency + exception/ExceptionHandlingConfig's
		     @Import are what make Architecture Rule #6 (error envelope on
		     every error) actually true here, instead of every error silently
		     falling through as a framework-default error body. Same
		     groupId/artifactId/version as connection-service's and
		     rating-service's pom.xml — the envelope shape is byte-for-byte
		     identical across every Java service, instead of a copy-pasted
		     @ControllerAdvice drifting apart over time. -->
		<dependency>
			<groupId>com.shareconnectsave</groupId>
			<artifactId>shared-java-lib</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>

		<!-- Database per Service: report-service is the only Java service on
		     MongoDB instead of SQL Server + JPA. spring-boot-starter-data-mongodb
		     replaces spring-boot-starter-data-jpa here (and there is no mssql-jdbc/
		     flyway pair to go with it — Mongo is schemaless, so there is nothing
		     for a migration tool to version). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Kafka: no producer/consumer code exists in THIS ticket
		     (T051 is connection + repository + startup health only), but it is
		     declared now because a later Phase 9 ticket (report.filed producer)
		     needs it, same reasoning as rating-service's pom.xml for its own
		     Kafka dependency at setup time. spring-kafka-test is intentionally
		     OMITTED (removed from the Initializr default) for the same "no
		     speculative test dependency for code that doesn't exist yet" reason
		     rating-service's pom.xml documents — add it back in the ticket that
		     actually writes a Kafka consumer/producer test. -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<!-- MapStruct: compile-time-generated DTO mapping. No DTOs exist yet in
		     this setup-only ticket, but declared now (per the ticket's explicit
		     dependency list) so the annotation-processor wiring below is already
		     correct for the first feature ticket that adds one. -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<!-- Pattern: annotation processor ORDER matters — Lombok must run
				     before MapStruct (see discovery-service's/rating-service's
				     pom.xml comment on this exact point). lombok-mapstruct-binding
				     is the shim that pins that ordering across javac/IDE
				     combinations. -->
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok-mapstruct-binding</artifactId>
									<version>0.2.0</version>
								</path>
								<path>
									<groupId>org.mapstruct</groupId>
									<artifactId>mapstruct-processor</artifactId>
									<version>${mapstruct.version}</version>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok-mapstruct-binding</artifactId>
									<version>0.2.0</version>
								</path>
								<path>
									<groupId>org.mapstruct</groupId>
									<artifactId>mapstruct-processor</artifactId>
									<version>${mapstruct.version}</version>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
